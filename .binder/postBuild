#!/bin/bash
set -ex

# Set conda prefix if not set
export CONDA_PREFIX=${CONDA_PREFIX:-${NB_PYTHON_PREFIX}}

# Verify CMake version
echo "CMake version:"
cmake --version

# Install AWS SDK for C++ - clone with submodules, use version known to work
cd /tmp
git clone --recurse-submodules --depth 1 --branch 1.11.100 https://github.com/aws/aws-sdk-cpp.git
cd aws-sdk-cpp
mkdir build && cd build

cmake .. \
  -DCMAKE_INSTALL_PREFIX=${CONDA_PREFIX} \
  -DCMAKE_BUILD_TYPE=Release \
  -DBUILD_ONLY="s3" \
  -DENABLE_TESTING=OFF \
  -DBUILD_SHARED_LIBS=ON \
  -DCMAKE_INSTALL_LIBDIR=lib \
  -DAWS_WARNINGS_ARE_ERRORS=OFF

make -j2
make install

# Cleanup AWS SDK build
cd /tmp && rm -rf aws-sdk-cpp

# Set up environment for netCDF to find AWS SDK
export PKG_CONFIG_PATH=${CONDA_PREFIX}/lib/pkgconfig:${PKG_CONFIG_PATH}
export LD_LIBRARY_PATH=${CONDA_PREFIX}/lib:${LD_LIBRARY_PATH}
export CMAKE_PREFIX_PATH=${CONDA_PREFIX}:${CMAKE_PREFIX_PATH}

# Now build netcdf-c with Zarr support
git clone --depth 1 --branch zarr-csl-fully https://github.com/mannreis/netcdf-c.git /tmp/netcdf-c
cd /tmp/netcdf-c
mkdir build && cd build

# Check if AWS SDK is findable
echo "Checking for AWS SDK libraries:"
ls -la ${CONDA_PREFIX}/lib/libaws* || echo "AWS libraries not found in expected location"
ls -la ${CONDA_PREFIX}/lib/cmake/AWSSDK/ || echo "AWS CMake configs not found"

cmake .. \
  -DCMAKE_INSTALL_PREFIX=${CONDA_PREFIX} \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_PREFIX_PATH=${CONDA_PREFIX} \
  -DNETCDF_ENABLE_TESTS=OFF \
  -DNETCDF_ENABLE_DAP=ON \
  -DNETCDF_ENABLE_NCZARR=ON \
  -DNETCDF_ENABLE_S3=ON \
  -DNETCDF_ENABLE_NCZARR_S3=ON \
  -DNETCDF_ENABLE_NCZARR_ZIP=ON \
  -DPLUGIN_INSTALL_DIR=${CONDA_PREFIX}/lib/netcdf/plugins \
  -DAWSSDK_ROOT_DIR=${CONDA_PREFIX} \
  -DAWSSDK_INCLUDE_DIR=${CONDA_PREFIX}/include \
  -DAWSSDK_LIB_DIR=${CONDA_PREFIX}/lib

make -j2
make install

# Verify installation
which ncdump
ncdump -h 2>&1 | head -10 || true

# Cleanup
cd /tmp && rm -rf netcdf-c

# Configure AWS for anonymous access
mkdir -p ${HOME}/.aws
cat > ${HOME}/.aws/config << 'EOF'
[default]
region = eu-central-1
EOF

# Set environment variable for anonymous access
echo "export AWS_NO_SIGN_REQUEST=YES" >> ${HOME}/.bashrc

echo "NetCDF-C with Zarr/S3 support installed successfully"
