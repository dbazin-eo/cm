#!/bin/bash
set -ex

# Clone the specific zarr-enabled branch
git clone --depth 1 --branch zarr-csl-fully https://github.com/mannreis/netcdf-c.git /tmp/netcdf-c

cd /tmp/netcdf-c
mkdir build && cd build

# Configure with Zarr and S3 support enabled
cmake .. \
  -DCMAKE_INSTALL_PREFIX=${CONDA_PREFIX} \
  -DCMAKE_BUILD_TYPE=Release \
  -DENABLE_TESTS=OFF \
  -DENABLE_DAP=ON \
  -DENABLE_NCZARR=ON \
  -DENABLE_S3=ON \
  -DENABLE_NCZARR_S3=ON \
  -DENABLE_NCZARR_ZIP=ON \
  -DPLUGIN_INSTALL_DIR=${CONDA_PREFIX}/lib/netcdf/plugins

make -j$(nproc)
make install

# Verify installation
${CONDA_PREFIX}/bin/ncdump -h 2>&1 | head -5

# Cleanup
cd /tmp && rm -rf netcdf-c

# Configure AWS (for anonymous S3 access)
mkdir -p ${HOME}/.aws
cat > ${HOME}/.aws/config << EOF
[default]
region = eu-central-1
s3 =
    signature_version = s3v4
EOF

cat > ${HOME}/.aws/credentials << EOF
[default]
aws_access_key_id = 
aws_secret_access_key = 
EOF

echo "NetCDF-C with Zarr/S3 support installed successfully"
