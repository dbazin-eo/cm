#!/bin/bash
set -ex

# Set conda prefix if not set
export CONDA_PREFIX=${CONDA_PREFIX:-${NB_PYTHON_PREFIX}}

# Verify CMake version
echo "CMake version:"
cmake --version

# Install AWS SDK for C++ - clone with submodules, use version known to work
cd /tmp
git clone --recurse-submodules --depth 1 --branch 1.11.100 https://github.com/aws/aws-sdk-cpp.git
cd aws-sdk-cpp
mkdir build && cd build

cmake .. \
  -DCMAKE_INSTALL_PREFIX=${CONDA_PREFIX} \
  -DCMAKE_BUILD_TYPE=Release \
  -DBUILD_ONLY="s3" \
  -DENABLE_TESTING=OFF \
  -DBUILD_SHARED_LIBS=ON \
  -DCMAKE_INSTALL_LIBDIR=lib \
  -DAWS_WARNINGS_ARE_ERRORS=OFF

make -j2
make install

# Cleanup AWS SDK build
cd /tmp && rm -rf aws-sdk-cpp

# Verify AWS SDK installation
echo "=== AWS SDK Installation Check ==="
ls -la ${CONDA_PREFIX}/lib/libaws* 2>&1 | head -20
echo ""
ls -la ${CONDA_PREFIX}/lib/cmake/ 2>&1 | head -20
echo "==================================="

# Set up environment for netCDF to find AWS SDK
export PKG_CONFIG_PATH=${CONDA_PREFIX}/lib/pkgconfig:${PKG_CONFIG_PATH}
export LD_LIBRARY_PATH=${CONDA_PREFIX}/lib:${LD_LIBRARY_PATH}

# Now build netcdf-c with Zarr support
git clone --depth 1 --branch zarr-csl-fully https://github.com/mannreis/netcdf-c.git /tmp/netcdf-c
cd /tmp/netcdf-c

# Check what the CMakeLists.txt is looking for
echo "=== Checking netCDF-C S3 detection logic ==="
grep -A 10 "S3 support" CMakeLists.txt || true
echo "============================================="

mkdir build && cd build

cmake .. \
  -DCMAKE_INSTALL_PREFIX=${CONDA_PREFIX} \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_PREFIX_PATH="${CONDA_PREFIX};${CONDA_PREFIX}/lib/cmake" \
  -DNETCDF_ENABLE_TESTS=OFF \
  -DNETCDF_ENABLE_DAP=ON \
  -DNETCDF_ENABLE_NCZARR=ON \
  -DNETCDF_ENABLE_S3=ON \
  -DNETCDF_ENABLE_NCZARR_S3=ON \
  -DNETCDF_ENABLE_NCZARR_ZIP=ON \
  -DPLUGIN_INSTALL_DIR=${CONDA_PREFIX}/lib/netcdf/plugins \
  -DAWSSDK_DIR=${CONDA_PREFIX}/lib/cmake/AWSSDK \
  -Daws-cpp-sdk-core_DIR=${CONDA_PREFIX}/lib/cmake/aws-cpp-sdk-core \
  -Daws-cpp-sdk-s3_DIR=${CONDA_PREFIX}/lib/cmake/aws-cpp-sdk-s3 2>&1 | tee cmake_output.log

# If cmake failed, show the relevant section of CMakeCache.txt
if [ $? -ne 0 ]; then
  echo "=== CMake failed, checking cache ==="
  grep -i "aws\|s3" CMakeCache.txt 2>&1 | head -30 || true
  echo "==================================="
  exit 1
fi

make -j2
make install

# Verify installation
which ncdump
ncdump -h 2>&1 | head -10 || true

# Cleanup
cd /tmp && rm -rf netcdf-c

# Configure AWS for anonymous access
mkdir -p ${HOME}/.aws
cat > ${HOME}/.aws/config << 'EOF'
[default]
region = eu-central-1
EOF

# Set environment variable for anonymous access
echo "export AWS_NO_SIGN_REQUEST=YES" >> ${HOME}/.bashrc

echo "NetCDF-C with Zarr/S3 support installed successfully"
