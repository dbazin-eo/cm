#!/bin/bash
set -ex

export CONDA_PREFIX=${CONDA_PREFIX:-${NB_PYTHON_PREFIX}}

echo "CMake version:"
cmake --version

# Install AWS SDK for C++
cd /tmp
git clone --recurse-submodules --depth 1 --branch 1.11.100 https://github.com/aws/aws-sdk-cpp.git
cd aws-sdk-cpp
mkdir build && cd build

cmake .. \
  -DCMAKE_INSTALL_PREFIX=${CONDA_PREFIX} \
  -DCMAKE_BUILD_TYPE=Release \
  -DBUILD_ONLY="s3;transfer" \
  -DENABLE_TESTING=OFF \
  -DBUILD_SHARED_LIBS=ON \
  -DCMAKE_INSTALL_LIBDIR=lib \
  -DAWS_WARNINGS_ARE_ERRORS=OFF

make -j2
make install
cd /tmp && rm -rf aws-sdk-cpp

export PKG_CONFIG_PATH=${CONDA_PREFIX}/lib/pkgconfig:${PKG_CONFIG_PATH}
export LD_LIBRARY_PATH=${CONDA_PREFIX}/lib:${LD_LIBRARY_PATH}

# Build netcdf-c from mannreis branch (has better S3/Zarr support)
git clone --depth 1 --branch zarr-csl-fully https://github.com/mannreis/netcdf-c.git /tmp/netcdf-c
cd /tmp/netcdf-c

# Check and fix duplicate function
echo "Checking for duplicate NC_s3sdklistall..."
grep -n "^NC_s3sdklistall" libdispatch/ncs3sdk_aws.cpp || true

# The file should have the duplicate at line 878, cut before it starts
head -n 876 libdispatch/ncs3sdk_aws.cpp > libdispatch/ncs3sdk_aws.cpp.fixed
mv libdispatch/ncs3sdk_aws.cpp.fixed libdispatch/ncs3sdk_aws.cpp

mkdir build && cd build

cmake .. \
  -DCMAKE_INSTALL_PREFIX=${CONDA_PREFIX} \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_PREFIX_PATH="${CONDA_PREFIX};${CONDA_PREFIX}/lib/cmake" \
  -DNETCDF_ENABLE_TESTS=OFF \
  -DNETCDF_ENABLE_DAP=ON \
  -DNETCDF_ENABLE_NCZARR=ON \
  -DNETCDF_ENABLE_S3_AWS=ON \
  -DNETCDF_ENABLE_NCZARR_S3=ON \
  -DNETCDF_ENABLE_NCZARR_ZIP=ON \
  -DPLUGIN_INSTALL_DIR=${CONDA_PREFIX}/lib/netcdf/plugins \
  -DAWSSDK_DIR=${CONDA_PREFIX}/lib/cmake/AWSSDK \
  -Daws-cpp-sdk-core_DIR=${CONDA_PREFIX}/lib/cmake/aws-cpp-sdk-core \
  -Daws-cpp-sdk-s3_DIR=${CONDA_PREFIX}/lib/cmake/aws-cpp-sdk-s3 \
  -Daws-cpp-sdk-transfer_DIR=${CONDA_PREFIX}/lib/cmake/aws-cpp-sdk-transfer

make -j2
make install

which ncdump
ncdump -h 2>&1 | head -10 || true

cd /tmp && rm -rf netcdf-c

# Set environment variables
echo "export LD_LIBRARY_PATH=${CONDA_PREFIX}/lib:\${LD_LIBRARY_PATH}" >> ${HOME}/.bashrc
echo "export AWS_NO_SIGN_REQUEST=YES" >> ${HOME}/.bashrc
echo "export AWS_ANON=YES" >> ${HOME}/.bashrc
echo "export AWS_EC2_METADATA_DISABLED=true" >> ${HOME}/.bashrc

# Create .netrc for anonymous access
cat > ${HOME}/.netrc << 'EOF'
machine s3.waw3-1.cloudferro.com
    login anonymous
    password anonymous
EOF
chmod 600 ${HOME}/.netrc

echo "NetCDF-C with Zarr/S3 support installed successfully"
